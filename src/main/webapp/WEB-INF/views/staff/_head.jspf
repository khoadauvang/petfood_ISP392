<%@ page pageEncoding="UTF-8" %>
<%-- Phần <head> dùng chung cho các trang /staff (include tĩnh).
     Style tạm để xem được dữ liệu khi test BE. FE team thay bằng css/ riêng. --%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
    body { font-family: Arial, sans-serif; margin: 16px; color: #222; }
    nav.staff { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding-bottom: 8px;
                border-bottom: 1px solid #ddd; margin-bottom: 12px; }
    nav.staff .who { margin-left: auto; }
    table { border-collapse: collapse; width: 100%; margin: 8px 0 16px; }
    th, td { border-bottom: 1px solid #e5e5e5; padding: 6px 8px; text-align: left; vertical-align: top; }
    th { background: #f6f6f6; }
    .num { text-align: right; white-space: nowrap; }
    .thumb { width: 56px; height: 56px; object-fit: contain; background: #f5f5f5; }
    .msg { padding: 8px 12px; border-radius: 4px; }
    .msg.ok { background: #e7f6ec; color: #0a5c26; }
    .msg.warn { background: #fff4e5; color: #7a4a00; }
    .msg.err { background: #fdecea; color: #8a1c13; }
    .err { color: #b00020; display: block; font-size: 13px; margin-top: 2px; }
    .hint { color: #666; font-size: 13px; }
    .badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; background: #eee; }
    .badge.ACTIVE, .badge.lv-OK { background: #e7f6ec; color: #0a5c26; }
    .badge.HIDDEN, .badge.DISCONTINUED { background: #eee; color: #555; }
    .badge.lv-RED, .badge.low { background: #fdecea; color: #8a1c13; }
    .badge.lv-BLOCKED { background: #b00020; color: #fff; }
    .badge.lv-EXPIRED { background: #333; color: #fff; }
    form.inline { display: inline; }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 8px; }
    .grid-form { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 10px 12px; max-width: 900px; }
    .grid-form > label { font-weight: bold; padding-top: 4px; }
    .slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; max-width: 980px; }
    .slot { border: 1px dashed #bbb; padding: 8px; border-radius: 6px; }
    .slot img, .slot .noimg { width: 100%; height: 130px; object-fit: contain; background: #f5f5f5; margin: 6px 0;
                              display: flex; align-items: center; justify-content: center; color: #999; }
    .gallery { display: flex; flex-wrap: wrap; gap: 8px; }
    .gallery img, .gallery .noimg { width: 150px; height: 150px; object-fit: contain; background: #f5f5f5;
                                    border: 1px solid #eee; display: flex; align-items: center; justify-content: center; color: #999; }
    .pre { white-space: pre-line; }
    .pager a, .pager strong { margin-right: 8px; }
</style>
