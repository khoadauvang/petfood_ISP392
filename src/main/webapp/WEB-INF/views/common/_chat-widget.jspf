<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="chatCtx" value="${pageContext.request.contextPath}"/>
<c:set var="chatUserId" value="${not empty currentUser and not empty currentUser.accountId ? currentUser.accountId : 'guest'}"/>

<!-- CỬA SỔ CHAT POPUP (NỔI NGAY TẠI CHỖ, KHÔNG CHUYỂN TRANG) -->
<div id="petFoodChatModal" class="chat-popup-container">
    <div class="chat-popup-header">
        <div class="chat-header-info">
            <span class="chat-status-dot"></span>
            <div>
                <strong>Hỗ trợ trực tuyến PetFood</strong>
                <small>Thường phản hồi trong vài phút</small>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:6px;">
            <button type="button" class="chat-reset-btn" onclick="resetChatHistory()" title="Bắt đầu lại cuộc trò chuyện mới" aria-label="Làm mới chat">
                <i class="fi fi-rr-refresh"></i>
            </button>
            <button type="button" class="chat-close-btn" id="chatCloseBtn" onclick="toggleChatBox()" aria-label="Đóng chat">&times;</button>
        </div>
    </div>

    <div class="chat-popup-body" id="chatMessageBody">
        <!-- Nội dung tin nhắn và các nút chủ đề sẽ được tự động nạp bởi loadChatHistory() -->
    </div>

    <!-- MẪU CHỦ ĐỀ CÂU HỎI NHANH ẨN ĐỂ TÁI SỬ DỤNG -->
    <template id="quickTopicsTemplate">
        <div class="chat-quick-topics">
            <button type="button" class="quick-topic-btn" onclick="handleQuickTopic('order')">
                <i class="fi fi-rr-box"></i> Tra cứu đơn hàng
            </button>
            <button type="button" class="quick-topic-btn" onclick="handleQuickTopic('return')">
                <i class="fi fi-rr-undo"></i> Chính sách đổi trả 3 ngày
            </button>
            <button type="button" class="quick-topic-btn" onclick="handleQuickTopic('fefo')">
                <i class="fi fi-rr-shield-check"></i> Hạn sử dụng (FEFO)
            </button>
            <button type="button" class="quick-topic-btn" onclick="handleQuickTopic('shipping')">
                <i class="fi fi-rr-shipping-fast"></i> Thời gian giao hàng 2H
            </button>
            <button type="button" class="quick-topic-btn" onclick="handleQuickTopic('human')">
                <i class="fi fi-rr-headset"></i> Gặp nhân viên tư vấn
            </button>
        </div>
    </template>

    <div class="chat-popup-footer">
        <input type="text" id="chatInputField" placeholder="Nhập câu hỏi của bạn..." onkeypress="handleChatEnter(event)">
        <button type="button" class="chat-send-btn" onclick="sendChatMessage()" title="Gửi tin nhắn">
            <i class="fi fi-rr-paper-plane"></i>
        </button>
    </div>
</div>

<!-- NÚT CHAT TRÒN NỔI GÓC DƯỚI BÊN PHẢI -->
<button type="button" class="chat-button" id="chatToggleBtn" onclick="toggleChatBox()" title="Mở hộp thoại hỗ trợ trực tuyến">
    <i class="fi fi-rr-comment-alt"></i>
</button>

<style>
/* =========================================================
   STYLE CHO CHAT POPUP WIDGET (TỰ ĐẦY ĐỦ VÀ ĐỘC LẬP)
   ========================================================= */
.chat-button {
    position: fixed;
    right: 25px;
    bottom: 25px;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border: none;
    border-radius: 50%;
    background: #F47721;
    color: #FFFFFF !important;
    box-shadow: 0 6px 22px rgba(244, 119, 33, 0.4);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.chat-button:hover {
    background: #E96816;
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 8px 26px rgba(244, 119, 33, 0.5);
}

.chat-button i {
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF !important;
}

.chat-popup-container {
    position: fixed;
    right: 25px;
    bottom: 92px;
    z-index: 10000;
    width: 360px;
    height: 480px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 120px);
    background: #FFFFFF;
    border: 1px solid #F4E3C9;
    border-radius: 18px;
    box-shadow: 0 14px 40px rgba(61, 48, 40, 0.22);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.95);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.chat-popup-container.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
}

.chat-popup-header {
    background: #F47721;
    color: #FFFFFF;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.chat-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.chat-status-dot {
    width: 10px;
    height: 10px;
    background: #4CD964;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
}

.chat-header-info strong {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
}

.chat-header-info small {
    display: block;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.85);
}

.chat-reset-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    transition: background .2s, color .2s;
}

.chat-reset-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
}

.chat-close-btn {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    padding: 0 4px;
    transition: opacity .2s;
}

.chat-close-btn:hover {
    opacity: 0.8;
}

.chat-popup-body {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    background: #FAF6F0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.chat-message-item {
    display: flex;
    max-width: 85%;
}

.chat-message-item.bot {
    align-self: flex-start;
}

.chat-message-item.user {
    align-self: flex-end;
}

.chat-bubble {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 13px;
    line-height: 1.5;
    word-break: break-word;
}

.chat-message-item.bot .chat-bubble {
    background: #FFFFFF;
    color: #3D3028;
    border: 1px solid #F4E3C9;
    border-bottom-left-radius: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.03);
}

.chat-message-item.user .chat-bubble {
    background: #F47721;
    color: #FFFFFF;
    border-bottom-right-radius: 4px;
}

.chat-bubble a {
    color: #F47721;
    font-weight: 700;
    text-decoration: underline;
}

.chat-quick-topics {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
}

.quick-topic-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid #EADBC8;
    background: #FFFFFF;
    color: #57483A;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
}

.quick-topic-btn i {
    color: #F47721;
    font-size: 13px;
    flex-shrink: 0;
}

.quick-topic-btn:hover {
    background: #FFF5EC;
    border-color: #F47721;
    color: #E96816;
    transform: translateX(2px);
}

.chat-popup-footer {
    padding: 12px;
    background: #FFFFFF;
    border-top: 1px solid #F4E3C9;
    display: flex;
    align-items: center;
    gap: 8px;
}

.chat-popup-footer input {
    flex: 1;
    height: 38px;
    padding: 0 14px;
    border: 1px solid #E7D8C7;
    border-radius: 12px;
    outline: none;
    font-size: 13px;
    background: #FFFCF8;
    color: #3D3028;
    box-sizing: border-box;
}

.chat-popup-footer input:focus {
    border-color: #F47721;
}

.chat-send-btn {
    width: 38px;
    height: 38px;
    background: #F47721;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(244, 119, 33, 0.25);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    flex-shrink: 0;
}

.chat-send-btn:hover {
    background: #E96816;
}

.chat-send-btn i {
    font-size: 15px;
}
</style>

<script>
    const chatAppCtx = '${chatCtx}';
    const currentChatUserId = '${chatUserId}';
    const chatStorageKey = 'petfood_chat_messages_' + currentChatUserId;

    function toggleChatBox() {
        const modal = document.getElementById('petFoodChatModal') || document.getElementById('chatBoxModal');
        if (modal) {
            modal.classList.toggle('active');
            const isOpen = modal.classList.contains('active');
            try {
                sessionStorage.setItem('petfood_chat_open', isOpen ? 'true' : 'false');
            } catch(e) {}
            
            if (isOpen) {
                const input = document.getElementById('chatInputField');
                if (input) setTimeout(() => input.focus(), 200);
            }
        }
    }

    function getSavedChatMessages() {
        try {
            const raw = localStorage.getItem(chatStorageKey);
            return raw ? JSON.parse(raw) : null;
        } catch (e) {
            return null;
        }
    }

    function persistChatMessage(type, htmlContent) {
        try {
            let msgs = getSavedChatMessages() || [];
            msgs.push({ type: type, html: htmlContent, time: Date.now() });
            localStorage.setItem(chatStorageKey, JSON.stringify(msgs));
        } catch (e) {
            console.error('Không thể lưu tin nhắn vào localStorage:', e);
        }
    }

    function renderDefaultChatView() {
        const body = document.getElementById('chatMessageBody');
        if (!body) return;

        body.innerHTML = '';
        
        // Tin nhắn chào mừng mặc định
        const welcomeDiv = document.createElement('div');
        welcomeDiv.className = 'chat-message-item bot';
        welcomeDiv.innerHTML = '<div class="chat-bubble">Dạ chào bạn! PetFood có thể hỗ trợ gì cho bạn hôm nay ạ? Bạn có thể chọn nhanh chủ đề bên dưới hoặc gõ tin nhắn trực tiếp nhé! 🐾</div>';
        body.appendChild(welcomeDiv);

        // Các chủ đề gợi ý mặc định
        const tpl = document.getElementById('quickTopicsTemplate');
        if (tpl) {
            const clone = tpl.content.cloneNode(true);
            body.appendChild(clone);
        }
        body.scrollTop = body.scrollHeight;
    }

    function loadChatHistory() {
        const body = document.getElementById('chatMessageBody');
        if (!body) return;

        const saved = getSavedChatMessages();
        if (!saved || saved.length === 0) {
            renderDefaultChatView();
            return;
        }

        body.innerHTML = '';
        saved.forEach(msg => {
            const msgDiv = document.createElement('div');
            msgDiv.className = 'chat-message-item ' + msg.type;
            msgDiv.innerHTML = '<div class="chat-bubble">' + msg.html + '</div>';
            body.appendChild(msgDiv);
        });

        // Hiển thị nút để khách có thể bấm lại chủ đề gợi ý bất cứ lúc nào
        showRestartOption();
        body.scrollTop = body.scrollHeight;
    }

    function resetChatHistory() {
        if (confirm('Bạn có muốn bắt đầu cuộc trò chuyện mới không? Lịch sử chat hiện tại sẽ được làm mới.')) {
            try {
                localStorage.removeItem(chatStorageKey);
            } catch(e) {}
            renderDefaultChatView();
        }
    }

    const quickTopicAnswers = {
        'order': 'Để tra cứu đơn hàng, bạn có thể vào mục <a href="' + chatAppCtx + '/orders">Đơn hàng của tôi</a> để xem mã vận đơn, tiến trình đóng gói và vị trí tài xế giao hàng nhé! 📦',
        'return': 'PetFood cam kết chính sách <strong>Đổi trả trong vòng 3 ngày</strong> kể từ khi nhận hàng cho mọi trường hợp rách bao bì, lỗi sản xuất hoặc sai loại sản phẩm. Bạn chỉ cần vào chi tiết đơn hàng bấm Yêu cầu trả hàng là được hỗ trợ ngay! 🔄',
        'fefo': 'Tất cả sản phẩm tại PetFood áp dụng quy trình kiểm soát xuất kho <strong>FEFO</strong> (First Expired, First Out) nghiêm ngặt, đảm bảo hàng giao đến tay bạn luôn có <strong>hạn sử dụng từ 90 ngày trở lên</strong>! 🥩',
        'shipping': 'PetFood hỗ trợ dịch vụ <strong>Giao hàng Hỏa tốc 2H</strong> cho các quận nội thành TP.HCM & Hà Nội, và 1-2 ngày đối với các tỉnh thành toàn quốc. Bạn cứ yên tâm bé cưng không lo đói bữa nhé! 🚚',
        'human': 'Bạn có thể liên hệ trực tiếp Tổng đài CSKH miễn phí <strong>1900 6868</strong> (8:00 - 21:00 hàng ngày) hoặc để lại số điện thoại ngay tại đây, chuyên viên PetFood sẽ gọi lại hỗ trợ bạn trong vòng 5 phút ạ! 📞'
    };

    function handleQuickTopic(topicKey) {
        const labels = {
            'order': 'Tra cứu đơn hàng',
            'return': 'Chính sách đổi trả 3 ngày',
            'fefo': 'Hạn sử dụng (FEFO)',
            'shipping': 'Thời gian giao hàng 2H',
            'human': 'Gặp nhân viên tư vấn'
        };

        const userText = labels[topicKey] || 'Tư vấn';
        appendChatMessage('user', userText);

        const reply = quickTopicAnswers[topicKey] || 'PetFood đã ghi nhận câu hỏi của bạn và sẽ phản hồi sớm nhất!';
        setTimeout(() => {
            appendChatMessage('bot', reply);
            showRestartOption();
        }, 400);
    }

    function sendChatMessage() {
        const input = document.getElementById('chatInputField');
        if (!input) return;

        const text = input.value.trim();
        if (!text) return;

        appendChatMessage('user', escapeChatHtml(text));
        input.value = '';

        setTimeout(() => {
            const lower = text.toLowerCase();
            let botReply = 'Cảm ơn bạn đã nhắn tin! Chuyên viên dinh dưỡng của PetFood đã nhận được tin nhắn và sẽ hỗ trợ giải đáp cho bạn ngay trong giây lát ạ! 🐶🐾';
            
            if (lower.includes('đơn') || lower.includes('hàng') || lower.includes('ship')) {
                botReply = 'Bạn muốn kiểm tra đơn hàng đúng không ạ? Hãy truy cập vào <a href="' + chatAppCtx + '/orders">Đơn hàng của tôi</a> hoặc gửi mã đơn (#PFS-...) tại đây để tụi mình tra cứu giúp nhé!';
            } else if (lower.includes('đổi') || lower.includes('trả') || lower.includes('lỗi')) {
                botReply = 'PetFood hỗ trợ đổi trả miễn phí trong 3 ngày nếu sản phẩm có lỗi bao bì hay cận date. Bạn có thể xem chi tiết tại <a href="' + chatAppCtx + '/policies">Chính sách đổi trả</a> nha!';
            } else if (lower.includes('hạn') || lower.includes('date') || lower.includes('fefo')) {
                botReply = 'Mọi sản phẩm bán ra đều được cam kết hạn dùng tối thiểu 90 ngày theo chuẩn FEFO. Đảm bảo an toàn tuyệt đối cho các bé cưng!';
            }

            appendChatMessage('bot', botReply);
            showRestartOption();
        }, 500);
    }

    function appendChatMessage(type, htmlContent) {
        const body = document.getElementById('chatMessageBody');
        if (!body) return;

        // Xóa nút "Chọn chủ đề khác" tạm thời nếu đang có ở cuối để tin nhắn mới nằm dưới
        const restartBox = document.getElementById('chatRestartBox');
        if (restartBox) restartBox.remove();

        const msgDiv = document.createElement('div');
        msgDiv.className = 'chat-message-item ' + type;
        msgDiv.innerHTML = '<div class="chat-bubble">' + htmlContent + '</div>';
        body.appendChild(msgDiv);
        body.scrollTop = body.scrollHeight;

        // Lưu vào LocalStorage
        persistChatMessage(type, htmlContent);
    }

    function showRestartOption() {
        const body = document.getElementById('chatMessageBody');
        if (!body) return;

        let restartDiv = document.getElementById('chatRestartBox');
        if (!restartDiv) {
            restartDiv = document.createElement('div');
            restartDiv.id = 'chatRestartBox';
            restartDiv.style.textAlign = 'center';
            restartDiv.style.margin = '10px 0 4px';
            restartDiv.innerHTML = '<button type="button" class="quick-topic-btn" style="display:inline-flex; width:auto; margin:0 auto; font-size:11.5px; padding:6px 12px;" onclick="restartChatTopics()"><i class="fi fi-rr-apps"></i> Xem lại danh mục câu hỏi nhanh</button>';
            body.appendChild(restartDiv);
            body.scrollTop = body.scrollHeight;
        }
    }

    function restartChatTopics() {
        const restartDiv = document.getElementById('chatRestartBox');
        if (restartDiv) restartDiv.remove();

        appendChatMessage('bot', 'Dạ đây là các chủ đề bạn có thể chọn nhanh nhé! 👇');
        
        const tpl = document.getElementById('quickTopicsTemplate');
        if (tpl) {
            const clone = tpl.content.cloneNode(true);
            document.getElementById('chatMessageBody').appendChild(clone);
            document.getElementById('chatMessageBody').scrollTop = document.getElementById('chatMessageBody').scrollHeight;
        }
    }

    function handleChatEnter(e) {
        if (e.key === 'Enter') {
            sendChatMessage();
        }
    }

    function escapeChatHtml(str) {
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    // Tự động tải lại lịch sử chat và khôi phục trạng thái khung chat khi tải trang
    window.addEventListener('DOMContentLoaded', () => {
        loadChatHistory();
        try {
            if (sessionStorage.getItem('petfood_chat_open') === 'true') {
                const modal = document.getElementById('petFoodChatModal');
                if (modal) modal.classList.add('active');
            }
        } catch(e) {}
    });
</script>
