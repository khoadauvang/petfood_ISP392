<%@ page pageEncoding="UTF-8" %>
<%-- Thanh đầu trang + thông báo dùng chung cho các trang phía khách (include tĩnh).
     Trang include file này phải khai báo taglib "c" và biến ctx (= contextPath) trước khi include.
     currentUser do CurrentUserAdvice đưa vào mọi trang (null nếu là Guest).
     Style tạm để xem được dữ liệu khi test BE. FE team thay bằng css/ riêng. --%>
<style>
    header.shop { display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
                  padding-bottom: 8px; border-bottom: 1px solid #ddd; margin-bottom: 12px; }
    header.shop .who { margin-left: auto; display: flex; gap: 8px; align-items: center; }
    header.shop .avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; background: #eee; }
    form.inline { display: inline; }
    .msg { padding: 8px 12px; border-radius: 6px; }
    .msg.ok { background: #e8f5e9; color: #0a7a2f; }
    .msg.warn { background: #fff8e1; color: #8a5a00; }
    .msg.err { background: #fdecea; color: #b00020; }
</style>
<header class="shop">
    <a href="${ctx}/"><strong>Food Pet Shop</strong></a>
    <span class="who">
        <c:choose>
            <c:when test="${currentUser == null}">
                <a href="${ctx}/login">Đăng nhập</a> | <a href="${ctx}/register">Đăng ký</a>
            </c:when>
            <c:otherwise>
                <c:if test="${currentUser.role == 'CUSTOMER'}">
                    <c:if test="${not empty currentUser.avatarUrl}">
                        <img class="avatar" src="${ctx}<c:out value='${currentUser.avatarUrl}'/>" alt="">
                    </c:if>
                    <a href="${ctx}/profile"><c:out value="${currentUser.fullName}"/></a>
                    <%-- cartItemCount do CartCountAdvice đưa vào --%>
                    <a href="${ctx}/cart">Giỏ hàng (${cartItemCount})</a>
                    <a href="${ctx}/orders">Đơn hàng</a>
                </c:if>
                <c:if test="${currentUser.role != 'CUSTOMER'}">
                    <c:out value="${currentUser.fullName}"/>
                    <a href="${ctx}/staff">Trang quản lý</a>
                </c:if>
                <form method="post" action="${ctx}/logout" class="inline">
                    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                    <button type="submit">Đăng xuất</button>
                </form>
            </c:otherwise>
        </c:choose>
    </span>
</header>
<c:if test="${not empty successMessage}"><p class="msg ok"><c:out value="${successMessage}"/></p></c:if>
<c:if test="${not empty warningMessage}"><p class="msg warn"><c:out value="${warningMessage}"/></p></c:if>
<c:if test="${not empty errorMessage}"><p class="msg err"><c:out value="${errorMessage}"/></p></c:if>
