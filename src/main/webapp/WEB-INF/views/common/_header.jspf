<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Thanh đầu trang dùng chung cho các trang phía khách (include tĩnh), giao diện của nhóm FE (css/home.css, css/products.css, css/cart.css).
     Trang include file này phải khai báo biến ctx (= contextPath) trước khi include; activePage (tuỳ chọn) để sáng mục menu.
     currentUser do CurrentUserAdvice đưa vào mọi trang (null nếu là Guest), cartItemCount do CartCountAdvice đưa vào.
     Trang tự hiện thông báo flash theo giao diện riêng thì đặt ownFlash = true trước khi include để không hiện 2 lần.
     Link font icon đặt ở đây để các trang chưa dùng css mới vẫn hiện được icon. --%>
<link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-regular-rounded/css/uicons-regular-rounded.css">
<style>
    /* =========================================================
   STYLE CHO USER DROPDOWN MENU TRÊN HEADER
   ========================================================= */
.user-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
}

/* Menu thả xuống ẩn đi mặc định */
.user-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 230px;
    background: var(--white, #FFFFFF);
    border: 1px solid var(--border, #F4E3C9);
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(61, 48, 40, 0.12);
    padding: 12px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1000;
}

/* Rê chuột vào wrapper hoặc menu thì hiện lên mượt mà */
.user-dropdown-wrapper:hover .user-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.dropdown-user-header {
    padding: 4px 16px 10px;
}

.dropdown-welcome {
    display: block;
    font-size: 11.5px;
    color: var(--text-muted, #817872);
}

.dropdown-name {
    display: block;
    font-size: 13.5px;
    font-weight: 800;
    color: var(--text, #3D3028);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dropdown-divider {
    height: 1px;
    background: var(--border, #F4E3C9);
    margin: 6px 0;
}

.user-dropdown-menu a,
.dropdown-logout-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 9px 16px;
    background: transparent;
    border: none;
    text-align: left;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-body, #57483A);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}

.user-dropdown-menu a i,
.dropdown-logout-btn i {
    color: var(--orange, #F47721);
    font-size: 14px;
}

.user-dropdown-menu a:hover {
    background: var(--orange-soft, #FFF0E6);
    color: var(--orange-dark, #E96816);
}

.dropdown-logout-btn {
    color: var(--red-sale, #D9381E);
}

.dropdown-logout-btn i {
    color: var(--red-sale, #D9381E) !important;
}

.dropdown-logout-btn:hover {
    background: #FDE8E4;
}

/* Các phần header cũ vẫn dùng: thông báo flash, link Đăng nhập / Đăng ký của khách, badge giỏ hàng */
.header-auth { display: flex; align-items: center; gap: 8px; flex-shrink: 0; font-size: 13px; }
.header-auth a { color: inherit; text-decoration: none; font-weight: 600; }
.flash-msg { max-width: 1536px; margin: 12px auto; padding: 10px 16px; border-radius: 10px; font-size: 14px; }
.flash-msg.ok, .msg.ok { background: #e8f5e9; color: #0a7a2f; }
.flash-msg.warn, .msg.warn { background: #fff8e1; color: #8a5a00; }
.flash-msg.err, .msg.err { background: #fdecea; color: #b00020; }
/* các trang khách chưa làm lại giao diện vẫn dùng .msg và form.inline */
.msg { padding: 8px 12px; border-radius: 6px; }
form.inline { display: inline; }
</style>

<header class="header">
    <div class="header-container">
        <a href="${ctx}/" class="logo" aria-label="PetFood - Trang chủ">
            <i class="fi fi-rr-pets logo-icon"></i>
            <span class="logo-text">PetFood</span>
        </a>

        <nav class="nav-menu" aria-label="Điều hướng chính">
            <a href="${ctx}/" class="${activePage == 'home' ? 'active' : ''}">Trang chủ</a>
            <a href="${ctx}/products" class="${activePage == 'products' || activePage == 'dog' || activePage == 'cat' ? 'active' : ''}">Sản phẩm</a>
            <a href="${ctx}/flash-sale" class="${activePage == 'flash-sale' ? 'active' : ''}">Flash Sale</a>
            <a href="${ctx}/policies" class="${activePage == 'policies' ? 'active' : ''}">Chính sách</a>
            <a href="${ctx}/support" class="${activePage == 'support' ? 'active' : ''}">Hỗ trợ</a>
        </nav>

        <form class="search-box" method="get" action="${ctx}/products">
            <i class="fi fi-rr-search search-icon"></i>
            <input type="text" name="keyword"
                   value="<c:out value='${filter.keyword}'/>"
                   placeholder="Tìm kiếm sản phẩm, thương hiệu..."
                   aria-label="Tìm kiếm sản phẩm">
        </form>

        <div class="header-icons">
            <%-- Giỏ hàng chỉ dành cho khách (/cart chỉ cho CUSTOMER); Guest bấm vào sẽ được đưa tới trang đăng nhập --%>
            <c:if test="${currentUser == null or currentUser.role == 'CUSTOMER'}">
                <a href="${ctx}/cart" class="header-cart" title="Giỏ hàng" aria-label="Giỏ hàng">
                    <i class="fi fi-rr-shopping-cart"></i>
                    <c:if test="${cartItemCount > 0}">
                        <span class="cart-badge">${cartItemCount}</span>
                    </c:if>
                </a>
            </c:if>

            <%-- Icon tài khoản: rê chuột vào hiện menu thả xuống --%>
            <div class="user-dropdown-wrapper">
                <c:choose>
                    <c:when test="${currentUser == null}">
                        <a href="${ctx}/login" class="header-user" title="Đăng nhập" aria-label="Đăng nhập">
                            <i class="fi fi-rr-user"></i>
                        </a>
                        <div class="user-dropdown-menu">
                            <a href="${ctx}/login"><i class="fi fi-rr-sign-in-alt"></i> Đăng nhập</a>
                            <a href="${ctx}/register"><i class="fi fi-rr-user-add"></i> Đăng ký</a>
                        </div>
                    </c:when>
                    <c:otherwise>
                        <%-- Staff / Admin không có hồ sơ khách và đơn hàng (/profile, /orders chỉ cho CUSTOMER) --%>
                        <c:set var="accountHome" value="${currentUser.role == 'CUSTOMER' ? '/profile' : (currentUser.role == 'ADMIN' ? '/admin' : '/staff')}"/>
                        <a href="${ctx}${accountHome}" class="header-user logged-in" title="Tài khoản của bạn" aria-label="Tài khoản">
                            <i class="fi fi-rr-user"></i>
                        </a>
                        <div class="user-dropdown-menu">
                            <div class="dropdown-user-header">
                                <span class="dropdown-welcome">Xin chào,</span>
                                <strong class="dropdown-name"><c:out value="${empty currentUser.fullName ? currentUser.email : currentUser.fullName}"/></strong>
                            </div>
                            <div class="dropdown-divider"></div>
                            <c:choose>
                                <c:when test="${currentUser.role == 'CUSTOMER'}">
                                    <a href="${ctx}/profile"><i class="fi fi-rr-id-card"></i> Thông tin tài khoản</a>
                                    <a href="${ctx}/orders"><i class="fi fi-rr-box"></i> Lịch sử đơn hàng</a>
                                </c:when>
                                <c:otherwise>
                                    <a href="${ctx}${accountHome}"><i class="fi fi-rr-dashboard"></i> Trang quản lý</a>
                                </c:otherwise>
                            </c:choose>
                            <div class="dropdown-divider"></div>
                            <form action="${ctx}/logout" method="post" style="margin: 0;">
                                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                                <button type="submit" class="dropdown-logout-btn">
                                    <i class="fi fi-rr-sign-out-alt"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </c:otherwise>
                </c:choose>
            </div>
        </div>
    </div>
</header>
<c:if test="${not ownFlash}">
    <c:if test="${not empty successMessage}"><p class="flash-msg ok"><c:out value="${successMessage}"/></p></c:if>
    <c:if test="${not empty warningMessage}"><p class="flash-msg warn"><c:out value="${warningMessage}"/></p></c:if>
    <c:if test="${not empty errorMessage}"><p class="flash-msg err"><c:out value="${errorMessage}"/></p></c:if>
</c:if>
<%@ include file="/WEB-INF/views/common/_mask-url.jspf" %>
