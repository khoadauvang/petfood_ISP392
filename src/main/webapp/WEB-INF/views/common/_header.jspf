<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Thanh đầu trang dùng chung cho các trang phía khách (include tĩnh), giao diện của nhóm FE (css/home.css, css/products.css).
     Trang include file này phải khai báo biến ctx (= contextPath) trước khi include; activePage (tuỳ chọn) để sáng mục menu.
     currentUser do CurrentUserAdvice đưa vào mọi trang (null nếu là Guest), cartItemCount do CartCountAdvice đưa vào.
     Link font icon đặt ở đây để các trang chưa dùng css mới vẫn hiện được icon. --%>
<link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-regular-rounded/css/uicons-regular-rounded.css">
<style>
    .header-auth { display: flex; align-items: center; gap: 8px; flex-shrink: 0; font-size: 13px; }
    .header-auth a { color: inherit; text-decoration: none; font-weight: 600; }
    .header-auth form { display: inline; margin: 0; }
    .header-auth button { border: 0; background: none; cursor: pointer; font: inherit; font-weight: 600; color: inherit; padding: 0; }
    .cart-icon { position: relative; }
    .cart-count { position: absolute; top: -4px; right: -4px; min-width: 18px; height: 18px; padding: 0 4px;
                  border-radius: 9px; background: #F47721; color: #fff; font-size: 11px; font-weight: 700;
                  display: flex; align-items: center; justify-content: center; line-height: 1; }
    .flash-msg { max-width: 1536px; margin: 12px auto; padding: 10px 16px; border-radius: 10px; font-size: 14px; }
    .flash-msg.ok, .msg.ok { background: #e8f5e9; color: #0a7a2f; }
    .flash-msg.warn, .msg.warn { background: #fff8e1; color: #8a5a00; }
    .flash-msg.err, .msg.err { background: #fdecea; color: #b00020; }
    /* các trang khách chưa làm lại giao diện vẫn dùng .msg và form.inline */
    .msg { padding: 8px 12px; border-radius: 6px; }
    form.inline { display: inline; }
</style>

<header class="header">
    <div class="header-container">
        <a href="${ctx}/" class="logo" aria-label="PetFood - Trang chủ">
            <i class="fi fi-rr-pets logo-icon"></i>
            <span class="logo-text">PetFood</span>
        </a>

        <nav class="nav-menu" aria-label="Điều hướng chính">
            <a href="${ctx}/" class="${activePage == 'home' ? 'active' : ''}">Trang chủ</a>
            <a href="${ctx}/products" class="${activePage == 'products' || activePage == 'dog' || activePage == 'cat' ? 'active' : ''}">Sản phẩm</a>
            <a href="${ctx}/flash-sale" class="${activePage == 'flash-sale' ? 'active' : ''}">Flash Sale</a>
            <a href="${ctx}/policies" class="${activePage == 'policies' ? 'active' : ''}">Chính sách</a>
            <a href="${ctx}/support" class="${activePage == 'support' ? 'active' : ''}">Hỗ trợ</a>
        </nav>

        <form class="search-box" method="get" action="${ctx}/products">
            <i class="fi fi-rr-search search-icon"></i>
            <input type="text" name="keyword"
                   value="<c:out value='${filter.keyword}'/>"
                   placeholder="Tìm kiếm sản phẩm, thương hiệu..."
                   aria-label="Tìm kiếm sản phẩm">
        </form>

        <div class="header-icons">
            <c:choose>
                <%-- Guest: /profile, /cart chỉ dành cho khách đã đăng nhập nên đưa thẳng tới trang đăng nhập --%>
                <c:when test="${currentUser == null}">
                    <span class="header-auth">
                        <a href="${ctx}/login">Đăng nhập</a> | <a href="${ctx}/register">Đăng ký</a>
                    </span>
                </c:when>
                <c:when test="${currentUser.role == 'CUSTOMER'}">
                    <a href="${ctx}/orders" class="header-icon" title="Đơn hàng của tôi" aria-label="Đơn hàng của tôi">
                        <i class="fi fi-rr-box-open"></i>
                    </a>
                    <a href="${ctx}/cart" class="header-icon cart-icon" title="Giỏ hàng" aria-label="Giỏ hàng">
                        <i class="fi fi-rr-shopping-cart"></i>
                        <c:if test="${cartItemCount > 0}"><span class="cart-count">${cartItemCount}</span></c:if>
                    </a>
                    <a href="${ctx}/profile" class="header-icon account-icon"
                       title="<c:out value='${currentUser.fullName}'/>" aria-label="Tài khoản">
                        <i class="fi fi-rr-user"></i>
                    </a>
                </c:when>
                <%-- Staff / Admin không có giỏ hàng và hồ sơ khách (/cart, /profile chỉ cho CUSTOMER) --%>
                <c:otherwise>
                    <a href="${ctx}${currentUser.role == 'ADMIN' ? '/admin' : '/staff'}" class="header-icon"
                       title="Trang quản lý" aria-label="Trang quản lý">
                        <i class="fi fi-rr-dashboard"></i>
                    </a>
                </c:otherwise>
            </c:choose>
            <c:if test="${currentUser != null}">
                <span class="header-auth">
                    <form method="post" action="${ctx}/logout">
                        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                        <button type="submit" title="Đăng xuất">Đăng xuất</button>
                    </form>
                </span>
            </c:if>
        </div>
    </div>
</header>
<c:if test="${not empty successMessage}"><p class="flash-msg ok"><c:out value="${successMessage}"/></p></c:if>
<c:if test="${not empty warningMessage}"><p class="flash-msg warn"><c:out value="${warningMessage}"/></p></c:if>
<c:if test="${not empty errorMessage}"><p class="flash-msg err"><c:out value="${errorMessage}"/></p></c:if>
